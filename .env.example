# --- TomTom ---
TOMTOM_API_KEY=replace_me

# Addresses are already configured for your commute.
ORIGIN_ADDRESS=Calle Zaragoza, 11, 28223 Pozuelo de Alarcón, Madrid, España
DESTINATION_ADDRESS=Calle Xaudaró, 25, Madrid, España
REFERENCE_ROUTE_FILE=state/reference_route.json

# --- Monitoring ---
TIMEZONE=Europe/Madrid
SAMPLE_TIMES=06:30,06:40,06:50,07:00,07:10,07:20,07:30
EMAIL_FROM_TIME=06:50
FORECAST_TARGET_TIME=07:00
MAX_SAMPLE_LATENESS_SECONDS=180

# Gradient thresholds: increase in trip minutes per 10 elapsed minutes.
GRADIENT_MODERATE_THRESHOLD=0.5
GRADIENT_FAST_THRESHOLD=1.5
GRADIENT_EXTREME_THRESHOLD=3.0

# --- Email (generic SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=javier.garrido.pino@gmail.com
SMTP_PASSWORD=use_an_app_password_or_smtp_password
SMTP_FROM=javier.garrido.pino@gmail.com
EMAIL_TO=javier.garrido.pino@gmail.com
SMTP_STARTTLS=false

# Set true for local testing: emails are printed instead of sent.
DRY_RUN=true
